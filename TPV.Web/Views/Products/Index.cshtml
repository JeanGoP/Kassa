@model IEnumerable<TPV.Application.DTOs.ProductDto>

@{
    ViewData["Title"] = "Listado de Productos";
}

<h1>Inventario de Repuestos</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Nuevo Producto</a>
</p>
<table class="table table-striped">
    <thead>
        <tr>
            <th>SKU</th>
            <th>Nombre</th>
            <th>Descripción</th>
            <th>Precio</th>
            <th>Categoría</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@item.SKU</td>
            <td>@item.Name</td>
            <td>@item.Description</td>
            <td>@item.Price.ToString("C")</td>
            <td>@item.CategoryName</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Detalles</a>
            </td>
        </tr>
}
    </tbody>
</table>
