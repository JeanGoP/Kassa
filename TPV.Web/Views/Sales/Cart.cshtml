@model List<TPV.Application.DTOs.SaleItemDto>
@{
    ViewData["Title"] = "Carrito de Ventas";
    var branches = (IEnumerable<TPV.Domain.Entities.Branch>)ViewBag.Branches;
    int? currentBranchId = ViewBag.CurrentBranchId as int?;
}

<h2>Carrito rápido</h2>

<div class="row mb-3">
    <div class="col-md-4">
        <form method="get" asp-action="Cart">
            <div class="form-group">
                <label>Sucursal</label>
                <select name="branchId" class="form-control" onchange="this.form.submit()">
                    @foreach (var b in branches)
                    {
                        <option value="@b.Id" selected="@(currentBranchId == b.Id)">@b.Name</option>
                    }
                </select>
            </div>
        </form>
    </div>
</div>

<div class="row mb-3">
    <div class="col-md-6">
        <form method="post" asp-action="AddItem">
            <input type="hidden" name="branchId" value="@currentBranchId" />
            <div class="input-group">
                <span class="input-group-text">SKU</span>
                <input type="text" name="sku" class="form-control" placeholder="Escanee o escriba SKU" />
                <span class="input-group-text">Cant</span>
                <input type="number" name="quantity" class="form-control" value="1" min="1" />
                <button class="btn btn-primary" type="submit">Agregar</button>
            </div>
        </form>
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger mt-2">@TempData["Error"]</div>
        }
    </div>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>SKU</th>
            <th>Producto</th>
            <th>Precio</th>
            <th>Cantidad</th>
            <th>Subtotal</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.SKU</td>
                <td>@item.ProductName</td>
                <td>@item.UnitPrice.ToString("C")</td>
                <td>@item.Quantity</td>
                <td>@(item.SubTotal.ToString("C"))</td>
                <td>
                    <form method="post" asp-action="RemoveItem">
                        <input type="hidden" name="productId" value="@item.ProductId" />
                        <input type="hidden" name="branchId" value="@currentBranchId" />
                        <button class="btn btn-danger btn-sm" type="submit">Quitar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="text-end">
    <a class="btn btn-success" asp-action="Checkout" asp-route-branchId="@currentBranchId">Continuar al pago</a>
</div>
