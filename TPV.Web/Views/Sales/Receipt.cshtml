@model TPV.Application.DTOs.SaleResultDto
@{
    ViewData["Title"] = "Comprobante";
}

<h2>Comprobante de Venta</h2>

<div class="card mb-3">
    <div class="card-body">
        <div><strong>Número:</strong> @Model.InvoiceNumber</div>
        <div><strong>Fecha:</strong> @Model.Date.ToLocalTime().ToString("g")</div>
        <div><strong>Sucursal:</strong> @Model.BranchId</div>
        <div><strong>Método de pago:</strong> @Model.PaymentMethod</div>
    </div>
 </div>

<table class="table">
    <thead>
        <tr>
            <th>SKU</th>
            <th>Producto</th>
            <th>Cantidad</th>
            <th>Precio</th>
            <th>Subtotal</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.SKU</td>
                <td>@item.ProductName</td>
                <td>@item.Quantity</td>
                <td>@item.UnitPrice.ToString("C")</td>
                <td>@(item.SubTotal.ToString("C"))</td>
            </tr>
        }
    </tbody>
</table>

<div class="text-end">
    <h4>Total: @Model.TotalAmount.ToString("C")</h4>
</div>

<div class="mt-3">
    <a class="btn btn-secondary" asp-controller="Sales" asp-action="Cart">Nueva venta</a>
</div>
