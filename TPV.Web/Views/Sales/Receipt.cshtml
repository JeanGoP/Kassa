@model TPV.Application.DTOs.SaleResultDto
@{
    ViewData["Title"] = "Comprobante";
}

<h2>Comprobante de Venta</h2>

<div class="card mb-3">
    <div class="card-body">
        <div><strong>Número:</strong> @Model.InvoiceNumber</div>
        <div><strong>Fecha:</strong> @Model.Date.ToLocalTime().ToString("g")</div>
        <div><strong>Sucursal:</strong> @Model.BranchId</div>
        <div><strong>Método de pago:</strong> @Model.PaymentMethod</div>
    </div>
 </div>

<table class="table">
    <thead>
        <tr>
            <th>Producto</th>
            <th>Cant.</th>
            <th>P. Unit</th>
            <th>IVA</th>
            <th>Total</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            var baseAmount = item.SubTotal - item.TaxAmount;
            <tr>
                <td>@item.ProductName</td>
                <td>@item.Quantity</td>
                <td>@item.UnitPrice.ToString("C")</td>
                <td>@item.TaxAmount.ToString("C") <small>(@item.TaxRate.ToString("0.##")%)</small></td>
                <td>@item.SubTotal.ToString("C")</td>
            </tr>
        }
    </tbody>
</table>

<div class="row">
    <div class="col-6 offset-6">
        <table class="table table-sm">
            <tr>
                <td><strong>Subtotal:</strong></td>
                <td class="text-end">@Model.Items.Sum(i => i.SubTotal - i.TaxAmount).ToString("C")</td>
            </tr>
            <tr>
                <td><strong>Total Impuestos:</strong></td>
                <td class="text-end">@Model.Items.Sum(i => i.TaxAmount).ToString("C")</td>
            </tr>
            <tr class="table-dark">
                <td><strong>TOTAL:</strong></td>
                <td class="text-end"><strong>@Model.TotalAmount.ToString("C")</strong></td>
            </tr>
        </table>
    </div>
</div>

<div class="mt-3">
    <a class="btn btn-secondary" asp-controller="Sales" asp-action="Cart">Nueva venta</a>
</div>
